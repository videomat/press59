#!/usr/bin/env bash
# Runs the homepage locally at http://localhost:8059 (or the port given as $1), with the
# /download and /latest.json functions backed by a local R2 seeded from dev/.
# Usage: ./scripts/web [port]

set -euo pipefail

cd "$(dirname "$0")/.."

port="${1:-8059}"
wrangler() {
  npx --yes wrangler@4 "$@"
}

echo "Seeding the local R2 bucket with the sample release in dev/..."
wrangler r2 object put press59-releases/latest.json \
  --file dev/latest.json --content-type application/json --local >/dev/null
wrangler r2 object put press59-releases/releases/Press59-dev.dmg \
  --file dev/Press59-dev.dmg --content-type application/x-apple-diskimage --local >/dev/null

exec npx --yes wrangler@4 pages dev web --port "$port" --ip 127.0.0.1
