#!/usr/bin/env bash
# Serves the homepage locally at http://localhost:8059 (or the port given as $1).
# Usage: ./scripts/web [port]

set -euo pipefail

port="${1:-8059}"
web_dir="$(cd "$(dirname "$0")/../web" && pwd)"

echo "Serving $web_dir at http://localhost:$port (Ctrl+C to stop)"
exec python3 -m http.server "$port" --bind 127.0.0.1 --directory "$web_dir"
