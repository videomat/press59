#!/bin/zsh
# Packages a release candidate: archives, signs with Developer ID, notarizes and staples the app and
# its DMG, and writes build/release/latest.json. Nothing is uploaded or tagged — test the DMG,
# then release it with ./scripts/release.

project_root="${0:A:h:h}"
cd "$project_root"

set -euo pipefail

notary_profile="${PRESS59_NOTARY_PROFILE:-press59-notary}"
app_directory="app"
project_bundle="$app_directory/Press59.xcodeproj"
project_file="$project_bundle/project.pbxproj"
project_yaml="$app_directory/project.yml"
export_options="$app_directory/Distribution/ExportOptions.plist"
release_directory="$project_root/build/release"
manifest_path="$release_directory/latest.json"
commit_path="$release_directory/commit"

usage() {
    print "Usage: ./scripts/package"
    print "       ./scripts/package setup-notary"
    print
    print "Before releasing:"
    print "  ./scripts/version <major|minor|patch>"
    print "  git commit -am \"Release version <version>\""
    print
    print "Environment: PRESS59_NOTARY_PROFILE overrides the 'press59-notary' Keychain profile."
}

require_command() {
    if ! command -v "$1" >/dev/null 2>&1; then
        print "Missing required command: $1"
        [[ -n "${2:-}" ]] && print "$2"
        exit 1
    fi
}

yaml_value() {
    awk -v key="$1:" '$1 == key { print $2; exit }' "$project_yaml"
}

project_value() {
    awk -F ' = ' -v key="$1" '$0 ~ key " = " { gsub(/;/, "", $2); print $2; exit }' "$project_file"
}

if [[ $# -gt 1 ]]; then
    usage
    exit 1
fi

if [[ $# -eq 1 ]]; then
    case "$1" in
        --help|-h) usage; exit 0 ;;
        setup-notary)
            print "Saving Apple notarization credentials as Keychain profile '$notary_profile'..."
            exec xcrun notarytool store-credentials "$notary_profile"
            ;;
        *) usage; exit 1 ;;
    esac
fi

require_command git
require_command xcodebuild
require_command xcrun
require_command lipo
require_command create-dmg "Install it with: brew install create-dmg"

if [[ "$(git branch --show-current)" != "main" ]]; then
    print "Packaging must run on main."
    exit 1
fi

if [[ -n "$(git status --porcelain)" ]]; then
    print "Packaging requires a clean working tree. Commit the version bump first."
    exit 1
fi

if [[ ! -f "$app_directory/Config/Signing.local.xcconfig" ]]; then
    print "Missing $app_directory/Config/Signing.local.xcconfig with DEVELOPMENT_TEAM."
    exit 1
fi

if ! security find-identity -v -p codesigning | grep -q "Developer ID Application"; then
    print "No Developer ID Application certificate found in the Keychain."
    exit 1
fi

version="$(yaml_value MARKETING_VERSION)"
build="$(yaml_value CURRENT_PROJECT_VERSION)"
if [[ ! "$version" =~ ^[0-9]+(\.[0-9]+){1,2}$ ||
        "$version" != "$(project_value MARKETING_VERSION)" ||
        ! "$build" =~ ^[0-9]+$ ||
        "$build" != "$(project_value CURRENT_PROJECT_VERSION)" ]]; then
    print "Version metadata is missing or out of sync."
    print "Run ./scripts/version <major|minor|patch>, review it, and commit both version files."
    exit 1
fi

tag="v${version}"
release_filename="Press59-${version}.dmg"
release_path="$release_directory/$release_filename"

if git rev-parse -q --verify "refs/tags/$tag" >/dev/null; then
    print "$version is already released (tag $tag exists). Bump the version with ./scripts/version first."
    exit 1
fi

if [[ -e "$release_path" ]]; then
    print "A release candidate for $version already exists: $release_path"
    print "Release it with ./scripts/release, or delete build/release to rebuild."
    exit 1
fi

print "Checking notarization credentials..."
if ! xcrun notarytool history --keychain-profile "$notary_profile" --output-format json >/dev/null; then
    print "Unable to use Keychain profile '$notary_profile'."
    print "Set it up with: ./scripts/package setup-notary"
    exit 1
fi

staging_root="$(mktemp -d "${TMPDIR:-/tmp}/press59-release.${version}.XXXXXX")"
trap '/bin/rm -rf -- "$staging_root"' EXIT
# Save the archive where Xcode keeps its own, so it shows in Organizer with its debug symbols.
archive_path="$HOME/Library/Developer/Xcode/Archives/$(date +%F)/Press59 ${version} (${build}) $(date +%H.%M).xcarchive"
export_path="$staging_root/export"
notary_zip="$staging_root/Press59.zip"
dmg_source="$staging_root/dmg"
staged_dmg="$staging_root/$release_filename"

print "Creating release archive for $version ($build)..."
xcodebuild archive \
    -project "$project_bundle" \
    -scheme Press59 \
    -configuration Release \
    -destination "generic/platform=macOS" \
    -archivePath "$archive_path" \
    -derivedDataPath "$staging_root/DerivedData" \
    ARCHS="arm64 x86_64" \
    ONLY_ACTIVE_ARCH=NO

print "Exporting the Developer ID signed app..."
xcodebuild -exportArchive \
    -archivePath "$archive_path" \
    -exportPath "$export_path" \
    -exportOptionsPlist "$export_options"

app_path="$export_path/Press59.app"
if [[ ! -d "$app_path" ]]; then
    print "Exported app not found: $app_path"
    exit 1
fi

app_architectures="$(lipo -archs "$app_path/Contents/MacOS/Press59")"
if [[ " $app_architectures " != *" arm64 "* || " $app_architectures " != *" x86_64 "* ]]; then
    print "Expected a universal app with arm64 and x86_64; found: $app_architectures"
    exit 1
fi
print "Verified app architectures: $app_architectures"
codesign --verify --deep --strict --verbose=2 "$app_path"

print "Notarizing the app..."
ditto -c -k --keepParent "$app_path" "$notary_zip"
xcrun notarytool submit "$notary_zip" --keychain-profile "$notary_profile" --wait --timeout 45m
xcrun stapler staple "$app_path"
xcrun stapler validate "$app_path"

print "Creating the disk image..."
mkdir -p "$dmg_source"
ditto "$app_path" "$dmg_source/Press59.app"
create-dmg \
    --volname "Press59" \
    --window-pos 200 120 \
    --window-size 560 340 \
    --icon-size 112 \
    --icon "Press59.app" 150 160 \
    --hide-extension "Press59.app" \
    --app-drop-link 410 160 \
    --hdiutil-retries 8 \
    --format UDZO \
    "$staged_dmg" \
    "$dmg_source"

print "Notarizing the disk image..."
xcrun notarytool submit "$staged_dmg" --keychain-profile "$notary_profile" --wait --timeout 45m
xcrun stapler staple "$staged_dmg"
xcrun stapler validate "$staged_dmg"
hdiutil verify "$staged_dmg"

/bin/rm -rf -- "$release_directory"
mkdir -p "$release_directory"
mv "$staged_dmg" "$release_path"

size="$(stat -f %z "$release_path")"
sha256="$(shasum -a 256 "$release_path" | awk '{ print $1 }')"
manifest_plist="$staging_root/latest.plist"
/usr/bin/plutil -create xml1 "$manifest_plist"
/usr/bin/plutil -insert version -string "$version" "$manifest_plist"
/usr/bin/plutil -insert build -string "$build" "$manifest_plist"
/usr/bin/plutil -insert key -string "releases/${release_filename}" "$manifest_plist"
/usr/bin/plutil -insert filename -string "$release_filename" "$manifest_plist"
/usr/bin/plutil -insert size -integer "$size" "$manifest_plist"
/usr/bin/plutil -insert sha256 -string "$sha256" "$manifest_plist"
/usr/bin/plutil -convert json -r -o "$manifest_path" "$manifest_plist"

# Remember which commit this candidate was built from, so release tags exactly that commit.
git rev-parse HEAD > "$commit_path"

size_mb="$(awk -v bytes="$size" 'BEGIN { printf "%.1f", bytes / 1000000 }')"
print
print "Release candidate $version ($build) is signed, notarized and packaged. Nothing was uploaded."
print "  DMG:      $release_path ($size_mb MB)"
print "  SHA-256:  $sha256"
print "  Archive:  in Xcode's Organizer (Window › Organizer)"
print
print "Test it: open the DMG, install Press59, grant Accessibility and try your shortcuts."
print "Then release it with: ./scripts/release"
